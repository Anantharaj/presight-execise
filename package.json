{
  "name": "presight-execise",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "lerna run dev --parallel --stream",
    "build": "lerna run build --stream",
    "test": "lerna run test --stream",
    "typecheck": "lerna run typecheck --stream",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:seed": "yarn workspace @presight/server db:seed",
    "storybook": "yarn workspace @presight/client storybook"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^24",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "eslint-plugin-react-refresh": "^0.4",
    "globals": "^16",
    "lerna": "~8.2.1",
    "prettier": "^3",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8"
  }
}
